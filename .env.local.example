# Optional. Only needed if you run the Vite dev server (`npm run dev`, port 5173)
# separately from the API (`wrangler pages dev`, port 8788). Point the frontend
# at the Functions origin so /api calls resolve.
#
# Copy to `.env.local` to use. Not needed for `npm run cf:dev`, which serves the
# built app and the API from the same origin.
# VITE_API_BASE=http://localhost:8788
